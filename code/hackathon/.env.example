# Copy to .env (gitignored) and paste from the machine's CONNECT tab -> Python -> "Include API key".
VIAM_MACHINE_ADDRESS=your-machine-main.xxxxxxxxxx.viam.cloud
VIAM_API_KEY_ID=
VIAM_API_KEY=
# Resource names. The hackathon deck uses arm / gripper / cam; the docs tutorial uses arm-1 / gripper-1 / cam-1.
VIAM_ARM_NAME=arm
VIAM_GRIPPER_NAME=gripper
VIAM_CAMERA_NAME=cam
# Claude turn (duet/claude_turn.py) and the pitch-deck image generator (docs/duet/pitch/gen_images.py).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
